JWT_SECRET=replace_with_a_strong_random_secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (Supabase). Falls back to SQLite when none of these are set.
# On Vercel with the Supabase integration these are provided automatically.
DATABASE_URL=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# Supabase Storage for task attachments. Falls back to local disk when unset.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=attachments
